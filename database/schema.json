{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tipspromenad question database",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "categories",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "questionId",
          "category",
          "subcategory",
          "translations"
        ],
        "properties": {
          "questionId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          },
          "category": {
            "type": "string"
          },
          "subcategory": {
            "type": "string"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "type": {
            "enum": [
              "choice",
              "numeric"
            ]
          },
          "referenceAnswer": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "translations": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z]{2,3}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "correctIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "numeric"
                }
              }
            },
            "then": {
              "required": [
                "referenceAnswer",
                "unit"
              ]
            },
            "else": {
              "properties": {
                "translations": {
                  "additionalProperties": {
                    "required": [
                      "options",
                      "correctIndex"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
